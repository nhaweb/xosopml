# ==============================================================================
# CẤU HÌNH KẾT NỐI HỆ THỐNG XOSOAPI (https://xosoapi.online)
# Lưu ý: Toàn bộ biến này chỉ đọc ở Server-side (Route Handlers / Server Components).
# Tuyệt đối KHÔNG thêm tiền tố NEXT_PUBLIC_ vào API Key/Token để bảo mật khóa.
# ==============================================================================

# Base URL của hệ thống XoSoAPI
XOSO_API_BASE_URL=https://xosoapi.online

# API Key lấy từ trang quản trị https://xosoapi.online (đính kèm qua header X-API-Key)
XOSO_API_KEY=your_xosoapi_key_here

# (Tùy chọn) Bearer Token nếu tài khoản dùng cơ chế Authorization Bearer
XOSO_API_TOKEN=

# Thời gian timeout tối đa cho mỗi request gọi tới xosoapi.online (ms)
XOSO_API_TIMEOUT_MS=8000

